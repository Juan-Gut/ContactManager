# EditorConfig for modern .NET (WinForms-friendly)
root = true

#############################
# General
#############################
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = tab
tab_width = 4
max_line_length = 120

[*.md]
trim_trailing_whitespace = false

#############################
# C# / .NET
#############################
[*.{cs,csx,vb,vbx}]
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_require_accessibility_modifiers = always:warning

# Namespaces / usings
csharp_using_directive_placement = outside_namespace:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion

# Readability / safety
csharp_prefer_braces = true:warning
csharp_indent_labels = one_less_than_current:suggestion
csharp_style_prefer_method_group_conversion = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion

# Type preferences (balanced modern style)
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Pattern matching / nullability-friendly style
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion
csharp_prefer_simple_default_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion

# Expression-bodied members (keep conservative for WinForms readability)
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

#############################
# Naming symbols
#############################
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = public, internal, protected, private

dotnet_naming_symbols.types.applicable_kinds = class, struct, enum
dotnet_naming_symbols.types.applicable_accessibilities = public, internal, protected, private

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_symbols.locals.applicable_kinds = local
dotnet_naming_symbols.locals.applicable_accessibilities = *

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.constants.applicable_accessibilities = *

#############################
# Naming styles
#############################
dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.interface_i_prefix.required_prefix = I
dotnet_naming_style.interface_i_prefix.capitalization = pascal_case

dotnet_naming_style.private_field_underscore.required_prefix = _
dotnet_naming_style.private_field_underscore.capitalization = camel_case

#############################
# Naming rules
#############################
dotnet_naming_rule.interfaces_must_have_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_must_have_i_prefix.style = interface_i_prefix
dotnet_naming_rule.interfaces_must_have_i_prefix.severity = warning

dotnet_naming_rule.types_must_be_pascal_case.symbols = types
dotnet_naming_rule.types_must_be_pascal_case.style = pascal_case
dotnet_naming_rule.types_must_be_pascal_case.severity = warning

dotnet_naming_rule.private_fields_must_have_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_must_have_underscore.style = private_field_underscore
dotnet_naming_rule.private_fields_must_have_underscore.severity = warning

dotnet_naming_rule.locals_must_be_camel_case.symbols = locals
dotnet_naming_rule.locals_must_be_camel_case.style = camel_case
dotnet_naming_rule.locals_must_be_camel_case.severity = warning

dotnet_naming_rule.constants_must_be_pascal_case.symbols = constants
dotnet_naming_rule.constants_must_be_pascal_case.style = pascal_case
dotnet_naming_rule.constants_must_be_pascal_case.severity = suggestion

dotnet_naming_rule.methods_must_be_pascal_case.symbols = methods
dotnet_naming_rule.methods_must_be_pascal_case.style = pascal_case
dotnet_naming_rule.methods_must_be_pascal_case.severity = warning

dotnet_naming_rule.parameters_must_be_camel_case.symbols = parameters
dotnet_naming_rule.parameters_must_be_camel_case.style = camel_case
dotnet_naming_rule.parameters_must_be_camel_case.severity = warning

#############################
# Generated files / designer
#############################
[*.Designer.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[*.{g.cs,g.i.cs,AssemblyInfo.cs}]
generated_code = true
dotnet_analyzer_diagnostic.severity = none